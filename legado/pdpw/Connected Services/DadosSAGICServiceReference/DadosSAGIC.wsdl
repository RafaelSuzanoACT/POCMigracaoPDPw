      <wsdl:output message="tns:IdAgentesSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="IdGrupos">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Retorna um Dataset com os identificadores e nomes dos GRUPOS que serão consultados na BDT</wsdl:documentation>
