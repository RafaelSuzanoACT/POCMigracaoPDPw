  <wsdl:portType name="DadosSAGICSoap">
    <wsdl:operation name="IdAgentes">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Retorna um Dataset com os códigos de identificação e nomes dos agentes (age) que estão relacionados com a lista de agentes do SCPC.</wsdl:documentation>
