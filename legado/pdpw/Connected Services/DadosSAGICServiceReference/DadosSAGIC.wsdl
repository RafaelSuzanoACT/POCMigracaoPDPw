      <wsdl:output message="tns:IdGruposSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="DadosHorariosAgentes">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Retorna um Dataset com os dados horários por agente para um período determinado conforme consta na base de dados. Agente: é o identificador do agente obtido no método IdAgentes. DtIni e DtFim: aaaa-MM-dd. </wsdl:documentation>
      <wsdl:input message="tns:DadosHorariosAgentesSoapIn" />
      <wsdl:output message="tns:DadosHorariosAgentesSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="DadosHorariosGrupos">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Retorna um Dataset com os dados horários dos GRUPOS conforme consta na BDT. Grupo: é o identificador do grupo obtido no método IdGrupos. DtIni e DtFim: aaaa-MM-dd. </wsdl:documentation>
      <wsdl:input message="tns:DadosHorariosGruposSoapIn" />
      <wsdl:output message="tns:DadosHorariosGruposSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="DadosEstadoUsina">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Retorna um dataset com id da usina, o estado de geração e sua duração (em horas). O parâmetro dataBase é obrigatório.</wsdl:documentation>
      <wsdl:input message="tns:DadosEstadoUsinaSoapIn" />
      <wsdl:output message="tns:DadosEstadoUsinaSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="DadosCadastroRespostaDemanda">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Retorna um dataset com codigo da usina do PDP, Id_agente, nome do agente, id_empreendimento, id_niveltensao, id_ptomedicao, nome ponto, dat_iniciovigencia, dat_terminovigencia. O parâmetro usina pdp é obrigatório.</wsdl:documentation>
      <wsdl:input message="tns:DadosCadastroRespostaDemandaSoapIn" />
      <wsdl:output message="tns:DadosCadastroRespostaDemandaSoapOut" />
    </wsdl:operation>
  </wsdl:portType>
