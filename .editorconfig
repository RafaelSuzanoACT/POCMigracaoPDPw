# EditorConfig helps maintain consistent coding styles

root = true

# C# files
[*.cs]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript/TypeScript files
[*.{js,jsx,ts,tsx}]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# JSON files
[*.json]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true

# YAML files
[*.{yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true

# Markdown files
[*.md]
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = true
